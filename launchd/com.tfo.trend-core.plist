  <key>Label</key><string>com.tfo.trend-core</string>
  <key>ProgramArguments</key><array>
    <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
    <string>/Users/test/Applications/MultiVenueDesk/trend_core_tick.py</string>
