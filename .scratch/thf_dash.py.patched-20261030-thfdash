"""TAYLOR HEDGE FUND dashboard (vd-engine), read-only, PAPER. http://100.127.19.45:18870/ (Tailscale) + http://127.0.0.1:18870/. Never writes trading data.
Cache: state/vd_engine/dash_cache.json (TTL 20s); the Dash Overlord may delete it to force a rebuild.
2026-10-30: serialize cache rebuilds (lock + unique tmp) so concurrent /api/state cannot 500 on replace race; keep a short in-memory copy to skip re-read/re-dump; slim top10 rows to fields the HTML uses."""
import datetime as dt, glob, json, math, os, sys, threading, time
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, BASE)
ST = os.path.join(BASE, "state", "vd_engine"); PORT = int(os.environ.get("THF_DASH_PORT", "18870")); CACHE = os.path.join(ST, "dash_cache.json")
VD_DASH = "http://100.127.19.45:18860/"; WAR_ROOM = "http://100.127.19.45:18812/warroom"
_LOCK = threading.Lock()
_MEM = None  # last built/loaded state dict
_MEM_T = 0.0  # monotonic time when _MEM was set
def rj(p, d=None):
    try: return json.load(open(p))
    except Exception: return d
def tail(p, n):
    try: return [json.loads(l) for l in open(p).read().splitlines()[-n:] if l.strip()]
    except Exception: return []
def clean(o):
    if isinstance(o, float): return o if math.isfinite(o) else None
    if isinstance(o, dict): return {k: clean(v) for k, v in o.items() if k != "_rows"}
    if isinstance(o, (list, tuple)): return [clean(v) for v in o]
    return o
# Fields the HTML table / best-idea line actually reads (cuts ~60KB of unused pillars/signals/news).
_TOP_KEEP = ("rank", "sym", "side", "grade", "score", "market_open", "wake_ok", "why_no_wake")
def slim_row(x):
    if not isinstance(x, dict): return x
    o = {k: x.get(k) for k in _TOP_KEEP if k in x}
    h = x.get("history") or {}
    if isinstance(h, dict):
        o["history"] = {k: h.get(k) for k in ("exp_R", "natural_pct") if k in h}
    return o
SEAT_ORDER = ["crypto", "trend", "price_action", "essentials_utilities", "macro", "energy", "banks", "healthcare", "news_filings", "tech_ai_infra", "fx_commodities"]
def build():
    t = time.time(); S = {}
    book = rj(os.path.join(BASE, "reports", "veteran_desk_book.json"), {}) or {}
    S["today"] = dict(today_pnl_aud=book.get("today_pnl_aud"), equity_aud=book.get("equity_aud"), pnl_since_inception_aud=book.get("pnl_since_inception_aud"), cash_aud=book.get("cash_aud"), book_updated=book.get("updated"), day=book.get("day"))
    try:
        from veteran_desk import leaderboard as LB
        lb = LB.standings(D=book) if book else None
    except Exception as x: lb = dict(error=str(x)[:160])
    S["leaderboard"] = lb
    rank = {r["seat"]: (i + 1, r) for i, r in enumerate((lb or {}).get("rows", []) or [])}
    top = {os.path.basename(f)[:-5]: rj(f, {}) for f in glob.glob(os.path.join(ST, "top10", "*.json"))}
    Q = tail(os.path.join(ST, "wake_queue.jsonl"), 400)
    wakes = {}
    for q in Q: wakes.setdefault(q["wake_id"], {}).update({k: v for k, v in q.items() if v is not None})
    WL = sorted(wakes.values(), key=lambda w: w.get("wake_id"), reverse=True)
    gpt = {os.path.basename(f)[:-5]: rj(f) for f in sorted(glob.glob(os.path.join(ST, "second_look", "gpt", "*.json")))}
    grok = {os.path.basename(f)[:-5]: rj(f) for f in sorted(glob.glob(os.path.join(ST, "second_look", "grok", "*.json")))}
    cards = []
    for seat in SEAT_ORDER + ["head_of_desk"]:
        v = top.get(seat) or {}; rk = rank.get(seat)
        sw = [w for w in WL if seat in (w.get("seats") or [])]
        lastg = next((gpt[w["wake_id"]] for w in sw if w["wake_id"] in gpt), None); lastk = next((grok[w["wake_id"]] for w in sw if w["wake_id"] in grok), None)
        raw_top = v.get("top10", []) or []
        slim_top = [slim_row(x) for x in raw_top]
        best = next((x for x in slim_top if x.get("grade") in ("A+", "A")), (slim_top or [None])[0])
        st = "green" if any(x.get("wake_ok") for x in raw_top) else "amber" if any(x.get("grade") in ("A", "A+") for x in raw_top) else "grey"
        bk = (book.get("seats") or {}).get(seat) or {}
        cards.append(dict(seat=seat, trader=v.get("trader") or seat, rank=rk[0] if rk else None, day_pnl_aud=(rk[1].get("day_pnl_aud") if rk else bk.get("today_pnl_aud")), equity_aud=bk.get("equity_aud"),
                          best=best, status=st, top10=slim_top, scanned=v.get("scanned"), n_A=v.get("n_A"), n_Aplus=v.get("n_Aplus"), updated=v.get("utc"), overlaps=v.get("overlaps"),
                          wakes_today=((rj(os.path.join(ST, "wake_counts.json"), {}) or {}).get("seat") or {}).get(seat, 0), last_wake=sw[0] if sw else None, gpt=lastg, grok=lastk,
                          open_positions=[dict(ticker=p.get("ticker"), side=p.get("side"), status=p.get("status")) for p in (bk.get("positions") or {}).values() if p.get("status") in ("open", "armed")]))
    hb = rj(os.path.join(ST, "hb", "engine.json"), {}) or {}; dm = rj(os.path.join(ST, "deadman_health.json"), {}) or {}; ov = rj(os.path.join(ST, "dash_overlord.json"), {}) or {}
    cov = rj(os.path.join(ST, "coverage.json"), {}) or {}; go = rj(os.path.join(ST, "gate_overlord.json"), {}) or {}
    now = dt.datetime.now(dt.timezone.utc)
    def age(u):
        try: return round((now - dt.datetime.fromisoformat(u)).total_seconds() / 60, 1)
        except Exception: return None
    broken = []
    if (age(hb.get("utc")) or 99) > 5: broken.append(dict(sev="red", what="Engine heartbeat is %s min old" % age(hb.get("utc"))))
    if hb.get("fails"): broken.append(dict(sev="amber", what="Engine had %s failed cycle(s) in a row" % hb.get("fails")))
    if (age(dm.get("utc")) or 99) > 6: broken.append(dict(sev="red", what="Dead-man watchdog has not checked in for %s min" % age(dm.get("utc"))))
    if dm.get("state") == "DEGRADED": broken.append(dict(sev="red", what="Watchdog says DEGRADED: " + str(dm.get("why"))))
    for g in cov.get("gaps", []): broken.append(g)
    for m in ov.get("mismatches", []): broken.append(dict(sev="red", what="Dash check: " + m))
    for s in go.get("stuck", []): broken.append(dict(sev="amber", what="Stuck: %s %s %s armed %sh unfilled" % (s.get("cls"), s.get("seat"), s.get("ticker"), s.get("age_h"))))
    C = rj(os.path.join(ST, "wake_counts.json"), {}) or {}
    S.update(cards=cards, wakes=WL[:40], wake_counts=C, caps=dict(per_seat=6, total=40), health=dict(engine=hb, engine_age_min=age(hb.get("utc")), deadman=dm, deadman_age_min=age(dm.get("utc")), overlord=ov, overlord_age_min=age(ov.get("utc"))),
             coverage=cov, gate_overlord=go, broken=broken, grok_queue=tail(os.path.join(ST, "grok_second_look_queue.jsonl"), 20), links=dict(vd_dash=VD_DASH, war_room=WAR_ROOM, leaderboard=VD_DASH + "#leaderboard"),
             built_utc=now.isoformat(), build_secs=round(time.time() - t, 2), first_top10=rj(os.path.join(ST, "first_top10.json")))
    S = clean(S)
    # Unique tmp avoids ENOENT when two builds finish near each other; lock still serializes the critical path.
    tmp = "%s.tmp.%s.%s" % (CACHE, os.getpid(), threading.get_ident())
    json.dump(S, open(tmp, "w"), default=str); os.replace(tmp, CACHE); return S
def state():
    global _MEM, _MEM_T
    now = time.monotonic()
    if _MEM is not None and (now - _MEM_T) < 20:
        return _MEM
    with _LOCK:
        now = time.monotonic()
        if _MEM is not None and (now - _MEM_T) < 20:
            return _MEM
        try:
            if time.time() - os.path.getmtime(CACHE) < 20:
                S = json.load(open(CACHE))
                _MEM, _MEM_T = S, time.monotonic()
                return S
        except Exception:
            pass
        S = build()
        _MEM, _MEM_T = S, time.monotonic()
        return S
HTML = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "thf_dash.html")).read() if os.path.exists(os.path.join(os.path.dirname(os.path.abspath(__file__)), "thf_dash.html")) else "<h1>Taylor Hedge Fund</h1>"
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _send(self, code, body, ct):
        b = body.encode() if isinstance(body, str) else body
        try:
            self.send_response(code); self.send_header("Content-Type", ct); self.send_header("Cache-Control", "no-store"); self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            pass
    def do_GET(self):
        try:
            if self.path.startswith("/api/state"): self._send(200, json.dumps(state(), default=str), "application/json")
            elif self.path.startswith("/healthz"): self._send(200, "ok", "text/plain")
            elif self.path in ("/", "/index.html") or self.path.startswith("/?"): self._send(200, HTML, "text/html; charset=utf-8")
            else: self._send(404, "not found", "text/plain")
        except Exception as e: self._send(500, json.dumps(dict(error=str(e)[:200])), "application/json")
if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
