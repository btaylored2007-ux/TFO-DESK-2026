def lse_all_listed(fetch=None):
    """All equities Yahoo lists on exchange LSE (main market + AIM; .L suffix), via yfinance screener paging (250/page).
    Non-equity / fund-like names (trusts, VCTs, ETFs/ETCs, income funds) dropped by name. Currency filter (GBp only) stays in main().
    Cached 1 day in state/calendar/lse/all_listed.json; listing only (no prices) so no lookahead."""
    p = os.path.join(CD, "lse", "all_listed.json")
    try:
        C = json.load(open(p))
        if time.time() - C.get("t", 0) < 86400 and len(C.get("rows", [])) >= 1000: return pd.DataFrame(C["rows"])
    except Exception: pass
    from yfinance import EquityQuery as Q
    q = Q("and", [Q("eq", ["exchange", "LSE"]), Q("gt", ["intradayprice", 0])])
    fetch = fetch or (lambda off: yf.screen(q, size=250, offset=off, sortField="intradaymarketcap", sortAsc=False))
    rows, off, total = [], 0, None
    while total is None or off < total:
        for k_ in range(4):   # Yahoo 429 -> back off and retry
            try: r = fetch(off); break
            except Exception as e:
                if k_ == 3: raise
                time.sleep(20 * (k_ + 1))
        qs = r.get("quotes") or []; total = r.get("total") or 0
        if not qs: break
        for z in qs:
            sy = str(z.get("symbol") or "")
            if not sy.endswith(".L") or z.get("quoteType") not in (None, "EQUITY"): continue
            nm = str(z.get("longName") or z.get("shortName") or sy)
            rows.append(dict(sym=sy, name=nm, sector="", lot=1, hk_shortsell=False, tier="lse_other"))
        off += len(qs); time.sleep(0.3)
    d = pd.DataFrame(rows).drop_duplicates("sym") if rows else pd.DataFrame(columns=["sym", "name", "sector", "lot", "hk_shortsell", "tier"])
    d = d[~d.name.astype(str).str.upper().str.contains(LSE_FUND_RX, regex=True)]
    os.makedirs(os.path.dirname(p), exist_ok=True); json.dump(dict(t=time.time(), total=total, rows=d.to_dict("records")), open(p, "w"))
    return d
def lse_sym(epic):
    """LSE EPIC -> Yahoo: 'BT.A' -> 'BT-A.L', 'BP.' -> 'BP.L', 'RR.' -> 'RR.L'."""
    e = str(epic).strip().upper().rstrip(".")
    return e.replace(".", "-") + ".L"
def lse_ccy(syms):
    """{sym: currency} via yfinance fast_info, cached 14d in state/calendar/lse/ccy.json. Only 'GBp' (pence) quotes are kept by main()."""
    p = os.path.join(CD, "lse", "ccy.json")
    try: C = json.load(open(p))
    except Exception: C = {}
    need = [s for s in syms if s not in C or time.time() - C[s].get("t", 0) > 14 * 86400 or not C[s].get("ccy")]
    from concurrent.futures import ThreadPoolExecutor
    def one(s):
        try: return s, dict(ccy=str(yf.Ticker(s).fast_info["currency"] or ""), t=time.time())
        except Exception: return s, dict(ccy="", t=time.time())
    with ThreadPoolExecutor(8) as ex:
        for s, v in ex.map(one, need): C[s] = v
    os.makedirs(os.path.dirname(p), exist_ok=True); json.dump(C, open(p, "w")); return {s: C[s]["ccy"] for s in syms if s in C}
def pence_glitch(c):
    """True if the close series mixes pounds and pence (Yahoo 100x glitch) -> drop the name (fail closed)."""
    c = c.dropna().iloc[-60:]
    return bool(len(c) and c.min() > 0 and c.max() / c.min() > 20)
def ibkr_short(mkt):
    """IBKR public short-stock file -> {code: (fee_pa, available)}; None if market has no file / empty."""
    f = AM.MARKETS[mkt]["ibkr_file"]
    try:
        import urllib.request
        raw = urllib.request.urlopen(f"ftp://shortstock:@ftp2.interactivebrokers.com/{f}.txt", timeout=90).read().decode("utf-8", "replace")
    except Exception: return None, None
    out, asof = {}, None
    for l in raw.splitlines():
        if l.startswith("#BOF"): asof = l.split("|")[1]
        if l.startswith("#"): continue
        p = l.split("|")
        if len(p) < 8: continue
        a = p[7].strip(); a = int(a[1:]) * 10 if a.startswith(">") else int(float(a or 0))
        try: fee = float(p[6]) / 100
        except Exception: fee = None
        out[p[0].strip()] = (fee, a)
    return (out or None), asof
def code_of(mkt, sym):
    if mkt == "lse": return sym[:-2].replace("-", ".")           # 'BT-A.L' -> IBKR 'BT.A'
    c = sym.split(".")[0]
    return str(int(c)) if mkt == "hk" else c
def sectors_yf(mkt, syms):
    p = os.path.join(CD, mkt, "sectors.json")
    try: C = json.load(open(p))
    except Exception: C = {}
    need = [s for s in syms if s not in C or time.time() - C[s].get("t", 0) > 14 * 86400]
    from concurrent.futures import ThreadPoolExecutor
    def one(s):
        try: i = yf.Ticker(s).info or {}; return s, dict(sector=i.get("sector") or i.get("industry") or "", country=i.get("country") or "", t=time.time())
        except Exception: return s, dict(sector="", country="", t=time.time() - 13 * 86400)
    with ThreadPoolExecutor(8) as ex:
        for s, v in ex.map(one, need): C[s] = v
    json.dump(C, open(p, "w")); return C
def earnings_dates(syms):
    out = {}
    from concurrent.futures import ThreadPoolExecutor
    def one(s):
        try:
            cal = yf.Ticker(s).calendar or {}; ed = cal.get("Earnings Date") if isinstance(cal, dict) else None
            if ed: return s, str(ed[0])[:10]
        except Exception: pass
        return s, None
    with ThreadPoolExecutor(8) as ex:
        for s, d in ex.map(one, syms):
            if d: out[s] = d
    return out
def ensure_refs(d, refs, fetch=None):
    """Index + FX reference columns must have data. Missing/empty -> re-download each one alone; still empty -> RuntimeError (no bad cache)."""
    miss = [r for r in refs if r not in d["Close"].columns or d["Close"][r].notna().sum() == 0]
    if not miss: return d
    fetch = fetch or (lambda s: yf.download(s, period="1y", auto_adjust=False, progress=False, threads=False))
    for r in miss:
        x = fetch(r)
        if x is None or len(x) == 0 or x["Close"].dropna().empty: raise RuntimeError(f"reference series {r} unavailable (index/FX) -> scan aborted, previous ranked file kept")
        for f in ("Close", "High", "Low", "Open", "Volume"):
            col = x[f]; col = col.iloc[:, 0] if hasattr(col, "columns") else col
            d[(f, r)] = col.reindex(d.index) if len(d.index) else col
    return d
def drop_open_bar(d, M, now=None):
    """Point-in-time guard (Brett 2026-10-28 20:31): drop today's (market-local) daily bar unless that session has closed + 5 min,
    so a scan run mid-session never ranks on a partial bar. Pre-open runs (13:15 WITA) are unaffected (no bar yet)."""
    from zoneinfo import ZoneInfo
    tz = ZoneInfo(M["tz"]); now = (now or dt.datetime.now(UTC)).astimezone(tz)
    hh, mm = map(int, M["sessions"][-1][1].split(":"))
    if now < now.replace(hour=hh, minute=mm, second=0, microsecond=0) + dt.timedelta(minutes=5):
        d = d[[x.date() < now.date() for x in d.index]]
    return d
def main(mkt):
    t0 = time.time(); M = AM.MARKETS[mkt]; cache = os.path.join(CD, mkt); os.makedirs(cache, exist_ok=True); rep = dict(market=mkt, name=M["name"], feeds={})
    D = listing(mkt); rep["feeds"]["listing"] = len(D)
    D = D[~D.name.astype(str).str.upper().str.contains("|".join(EXCL_WORDS))].drop_duplicates("sym")
    syms = D.sym.tolist()
    pk = os.path.join(cache, f"ohlcv_{dt.date.today()}.pkl")
    if os.path.exists(pk) and time.time() - os.path.getmtime(pk) < 6 * 3600: d = pd.read_pickle(pk)
    else: d = RS.dl(syms + [M["idx"], M["fx"]], "1y", chunk=300)
    d = ensure_refs(d, [M["idx"], M["fx"]]); d.to_pickle(pk)
    if mkt == "lse": d = drop_open_bar(d, M); rep["pit_last_bar"] = str(d.index[-1].date()) if len(d.index) else None   # 2026-10-28 bug #3: index/FX column empty in a failed bulk chunk -> iloc[-1] out-of-bounds
    C, H, L, O, V = d["Close"], d["High"], d["Low"], d["Open"], d["Volume"]
    fx = float(C[M["fx"]].dropna().iloc[-1]) / M.get("px_div", 1.0)   # local -> AUD (LSE: GBPAUD/100 = A$ per penny)
    adv = (C * V).iloc[-20:].mean(); px = C.ffill().iloc[-1]
    have = [s for s in syms if s in C.columns and C[s].notna().sum() >= 60]
    MINF = M.get("min_adv_aud", MIN_ADV_AUD); floor_local = MINF / fx
    keep = [s for s in have if adv.get(s, 0) >= floor_local and px.get(s, 0) > 0]
    rep.update(listed=len(syms), with_bars=len(have), fx_local_to_aud=fx, floor_aud=MINF, floor_local=round(floor_local), floor_label=f"A${MINF/1e6:g}m = {M['ccy']} {floor_local/1e6:,.1f}m 20d ADV",
               adv_ge_floor=len(keep), adv_ge_5m_aud=int(sum(adv.get(s, 0) * fx >= 5e6 for s in keep)))
    if mkt == "lse":     # pence quotes only + no pound/pence glitches (fail closed)
        cc = lse_ccy(keep); rep["feeds"]["lse_ccy"] = {k: sum(v == k for v in cc.values()) for k in set(cc.values())}
        keep = [s for s in keep if cc.get(s) == "GBp" and not pence_glitch(C[s])]; rep["adv_ge_floor_gbp_pence"] = len(keep)
    ix = C[M["idx"]].dropna(); reg = "long" if ix.iloc[-1] > ix.iloc[-50:].mean() else "short"
    sh, asof = (ibkr_short(mkt) if M["shorts"] else (None, None)); rep["feeds"]["ibkr_short_file"] = dict(asof=asof, n=len(sh or {}))
    meta = D.set_index("sym")
    if (meta.loc[keep, "sector"].astype(str).str.len() == 0).any():
        S = sectors_yf(mkt, [s for s in keep if not str(meta.at[s, "sector"])])
        for s, v in S.items():
            if s in meta.index and not str(meta.at[s, "sector"]): meta.at[s, "sector"] = v.get("sector") or ""
        indo = {s for s, v in S.items() if (v.get("country") or "").lower() == "indonesia"}
    else: indo = set()
    rows = []
    for s in keep:
        try:
            if s in indo: continue
            m = pd.concat([O[s], H[s], L[s], C[s], V[s]], axis=1, keys=list("ohlcv")).dropna(); m = m[(m.h >= m.l) & (m.c > 0)]
            if len(m) < 60 or m.index[-1].date() < dt.date.today() - dt.timedelta(days=6): continue
            r = RS.ind(m.o, m.h, m.l, m.c, m.v); mir = RS.ind(1 / m.o, 1 / m.l, 1 / m.h, 1 / m.c, m.v)
            p = float(r["px"]); adv_local = float(r["adv_usd"]); adv_aud = adv_local * fx    # bars are local ccy
            r["rs20"] = r["roc20"] - (ix.iloc[-1] / ix.iloc[-21] - 1) * 100; mir["rs20"] = -r["rs20"]
            tier = str(meta.at[s, "tier"]) if "tier" in meta.columns else ""
            spb = (M.get("spread_bp") or {}).get(tier, (M.get("spread_bp") or {}).get("default", 0.0))
            cost = 2 * SLIP_BP_SIDE / 100 + 100 * AM.tick(mkt, p) / p + 2 * 100 * M["comm"]["pct"] + 100 * (M["sell_tax"] + 2 * M.get("stamp", 0) + M.get("buy_stamp", 0)) + spb / 100
            r["adv_usd"] = adv_aud; mir["adv_usd"] = adv_aud      # ranker liquidity penalty in AUD-ish scale (same as ASX)
            sl = RS.score(pd.Series(r), cost)[0]; ss = RS.score(pd.Series(mir), cost)[0]
            code = code_of(mkt, s); ib = (sh or {}).get(code)
            if mkt == "hk": can, src = bool(meta.at[s, "hk_shortsell"]) and bool(ib and ib[1] > 0), f"HKEX designated list={bool(meta.at[s, 'hk_shortsell'])}; IBKR hongkong.txt {asof}: {ib}"
            elif mkt == "jp": can, src = bool(ib and ib[1] > 0), f"IBKR japan.txt {asof}: {ib}"
            elif mkt == "lse": can, src = bool(ib and ib[1] > 0), f"IBKR british.txt {asof}: {ib}"
            else: can, src = False, "LONG-ONLY market (no IBKR short selling)"
            d_ = reg if M["shorts"] else "long"
            r.update(sym=s, venue=mkt, etf=False, cls=f"{mkt}_equity", country=M["name"], sector=str(meta.at[s, "sector"] or ""), name=str(meta.at[s, "name"]),
                     lot=int(meta.at[s, "lot"] or 1), adv_local=adv_local, adv_aud=adv_aud, fx_aud=fx, score=sl, short_score=ss, dir=d_,
                     rank_score=(sl if d_ == "long" else ss), cost_pct=cost, tick=AM.tick(mkt, p), tier=tier, spread_bp=spb, shortable=can, short_src=src,
                     borrow_pa=(ib[0] if ib else None), borrow_avail=(ib[1] if ib else 0), excluded=False)
            rows.append(r)
        except Exception: pass
    R = pd.DataFrame(rows)
    R = pd.concat([R, pd.DataFrame([dict(sym=M["idx"], venue=mkt, cls="index_ref", px=float(ix.iloc[-1]), m50=float(ix.iloc[-50:].mean()), excluded="index reference only")])], ignore_index=True)
    R.to_csv(os.path.join(IN, f"ranked_{mkt}.csv"), index=False)
    top = list(R[R.cls == f"{mkt}_equity"].nlargest(60, "rank_score").sym) if len(rows) else []
    try: led = [t["sym"] for t in json.load(open(os.path.join(BASE, "state", f"hunt48_{mkt}", "ledger.json")))["trades"] if t["status"] in ("ARMED", "BENCH", "FILLED")]
    except Exception: led = []
    earn = earnings_dates(sorted(set(top) | set(led))); rep["feeds"]["yf_earnings_dates"] = len(earn)
    json.dump(dict(generated_utc=dt.datetime.now(UTC).isoformat(), earnings=earn, halted=[]), open(os.path.join(IN, f"{mkt}_events.json"), "w"), indent=1)
    rep.update(run_at=dt.datetime.now(UTC).isoformat(), scored=len(rows), regime=reg, index=M["idx"], index_px=float(ix.iloc[-1]), index_50dma=float(ix.iloc[-50:].mean()),
               shortable_in_universe=int(sum(bool(r["shortable"]) for r in rows)), indonesian_excluded=len(indo), runtime_s=round(time.time() - t0, 1))
    json.dump(rep, open(os.path.join(IN, f"ranked_{mkt}_report.json"), "w"), indent=1, default=str)
    print(json.dumps(rep, default=str)); return rep
