andardError=append:/opt/tfo/live/thf/logs/firm_risk_service.err.log\nNice=5\n[Install]\nWantedBy=multi-user.target\n\n# /etc/systemd/system/tfo-thf-firm-risk.service.d/40-autonomy-recovery.conf\n[Unit]\nStartLimitIntervalSec=600\nStartLimitBurst=5\n", "redactions": []}}, "tfo-dash-thf.service": {"show": {"rc": 0, "props": {"Type": "simple", "MainPID": "1929158", "Result": "success", "NRestarts": "0", "ExecMainStartTimestamp": "Sat 2026-11-07 20:01:12 WITA", "ExecMainExitTimestamp": "", "ExecMainStatus": "0", "ControlGroup": "/system.slice/tfo-dash-thf.service", "WorkingDirectory": "/opt/tfo/dash/base", "User": "tfo", "KillMode": "control-group", "Id": "tfo-dash-thf.service", "ActiveState": "active", "SubState": "running", "FragmentPath": "/etc/systemd/system/tfo-dash-thf.service", "DropInPaths": "/etc/systemd/system/tfo-dash-thf.service.d/30-thf-accepted-code.conf /etc/systemd/system/tfo-dash-thf.service.d/40-autonomy-recovery.conf /etc/systemd/system/tfo-dash-thf.service.d/chatimg.conf /etc/systemd/system/tfo-dash-thf.service.d/funmsg.conf /etc/systemd/system/tfo-dash-thf.service.d/paidkeys.conf", "UnitFileState": "enabled"}}, "cat": {"rc": 0, "text": "# /etc/systemd/system/tfo-dash-thf.service\n[Unit]\nDescription=TFO Taylor Hedge Fund dashboard READ-ONLY mirror (PAPER, tailnet via nginx)\nAfter=network-online.target tfo-dash-refresh.service\n[Service]\nUser=tfo\nWorkingDirectory=/opt/tfo/dash/base\nEnvironment=\"THF_DESK=1 THF_DASH_PORT=28870 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/tfo/live/thf\"\nExecStart=/opt/tfo/venv/bin/python /opt/tfo/dash/base/veteran_desk/thf_dash.py\nRestart=always\nRestartSec=5\nProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\nNoNewPrivileges=yes\nReadOnlyPaths=/opt/tfo\nReadWritePaths=/opt/tfo/dash/base/state/vd_engine /opt/tfo/dash/base/state/thf\nNice=5\n[Install]\nWantedBy=multi-user.target\n\n# /etc/systemd/system/tfo-dash-thf.service.d/30-thf-accepted-code.conf\n[Service]\nEnvironment=\"PYTHONPATH=/opt/tfo/dash/base\"\n\n# /etc/systemd/system/tfo-dash-thf.service.d/40-autonomy-recovery.conf\n[Unit]\nStartLimitIntervalSec=600\nStartLimitBurst=5\n\n# /etc/systemd/system/tfo-dash-thf.service.d/chatimg.conf\n[Service]\n# chatimg_20261102 (PAPER): chat image upload storage\nReadWritePaths=/opt/tfo/live/thf/state/thf/chat_imgs\n\n# /etc/systemd/system/tfo-dash-thf.service.d/funmsg.conf\n[Service]\n# tfo_funmsg_20261102 (Brett pt2520u, PAPER): funder messages PIN + write access to the message file only\nEnvironmentFile=/home/tfo/.tfo_secrets/thf_msg.env\nReadWritePaths=/opt/tfo/live/thf/state/funder_messages.jsonl /opt/tfo/live/thf/state/funder_messages.jsonl.lock /opt/tfo/live/thf/state/advisor_msgs.jsonl /opt/tfo/live/thf/state/advisor_msgs.jsonl.lock\n\n# /etc/systemd/system/tfo-dash-thf.service.d/paidkeys.conf\n# paidkeys_20261103 (master fixer, Brett 16:22 WITA \"We have all paid feeds please make sure they are working\"):\n# ProtectHome=yes hides /home/tfo/.tfo_secrets from this service, so pos_live never found its keys and every open position\n# showed \"no paid data\" (Yahoo, 15-20 min late). systemd reads EnvironmentFile BEFORE the sandbox, so the keys reach the\n# process as env vars (pos_live._key reads os.environ first) while /home stays hidden. Names only here, values never logged.\n[Service]\nEnvironmentFile=-/home/tfo/.tfo_secrets/massive.env\nEnvironmentFile=-/home/tfo/.tfo_secrets/eodhd.env\nEnvironmentFile=-/home/tfo/.tfo_secrets/coinalyze.env\n", "redactions": []}}}}
