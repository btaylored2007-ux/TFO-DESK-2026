[Unit]
Description=THF paper shadow sampler (no orders, no book tick)
After=network-online.target

[Service]
Type=oneshot
User=tfo
Group=tfo
WorkingDirectory=/opt/tfo/live/thf
Environment=HOME=/home/tfo
Environment=USER=tfo
Environment=LOGNAME=tfo
Environment=THF_DESK=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=THF_SHADOW_ROOT=/opt/tfo/live/thf
ExecStart=/opt/tfo/venv/bin/python -m veteran_desk.thf_shadow_sampler once
TimeoutStartSec=900
Nice=10
UMask=0077
NoNewPrivileges=true
